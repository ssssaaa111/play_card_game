{
  "name": "star-card-duel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "serve": "node scripts/dev-server.mjs",
    "dev": "npm run serve",
    "test": "node --test tests",
    "test:engine": "node --test tests/game-engine.test.mjs",
    "test:rules": "node --test tests/rules.test.mjs",
    "test:data": "node --test tests/data.test.mjs",
    "test:sim": "node --test tests/rule-simulator.test.mjs",
    "sim:rules": "node scripts/rule-simulator.mjs",
    "sim:ci": "node scripts/rule-simulator.mjs --games=20 --seed=ci-rule-sim --max-steps=400",
    "audit:finale": "node scripts/finale-balance-audit.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs"
  }
}
