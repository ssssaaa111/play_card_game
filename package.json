{
  "name": "star-card-duel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "serve": "node scripts/dev-server.mjs",
    "serve:online": "node scripts/duel-server.mjs",
    "dev": "npm run serve",
    "test": "node --test",
    "test:engine": "node --test tests/game-engine.test.mjs",
    "test:rules": "node --test tests/rules.test.mjs",
    "test:data": "node --test tests/data.test.mjs",
    "test:sim": "node --test tests/rule-simulator.test.mjs",
    "sim:rules": "node scripts/rule-simulator.mjs",
    "sim:ci": "node scripts/rule-simulator.mjs --games=20 --seed=ci-rule-sim --max-steps=400",
    "sim:finale": "node scripts/finale-sim.mjs",
    "audit:finale": "node scripts/finale-balance-audit.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "test:online": "node --test tests/duel-command.test.mjs tests/duel-view.test.mjs tests/duel-room.test.mjs tests/online-auth.test.mjs tests/online-auth-client.test.mjs tests/online-duel-ui.test.mjs tests/online-action-runner.test.mjs tests/online-regression.test.mjs tests/online-response.test.mjs",
    "smoke:online": "node scripts/online-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
